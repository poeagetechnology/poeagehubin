NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-this-local-password
DATABASE_URL=postgresql://poeage:replace-this-local-password@localhost:5432/poeage_ecom?schema=public

# Add these in a later authentication phase. Use strong, randomly generated secrets.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Integration credentials are server-side only; never use VITE_ prefixes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
