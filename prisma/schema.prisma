generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum SellerStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  SUSPENDED
}

enum ApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  PAUSED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
}

enum SellerOrderStatus {
  CONFIRMED
  PACKING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  PICKUP_SCHEDULED
  RECEIVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_TO_ORIGIN
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  ON_HOLD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model User {
  id                           String                       @id @default(cuid())
  email                        String                       @unique
  phone                        String?                      @unique
  passwordHash                 String?
  status                       UserStatus                   @default(PENDING)
  emailVerifiedAt              DateTime?
  phoneVerifiedAt              DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  roles                        UserRole[]
  customerProfile              CustomerProfile?
  sellerProfile                SellerProfile?
  deliveryPartner              DeliveryPartner?
  addresses                    Address[]                    @relation("AddressOwner")
  orders                       Order[]
  cart                         Cart?
  wishlist                     Wishlist?
  reviews                      Review[]
  notifications                Notification[]
  customerCrmNotes             CustomerCrmNote[]            @relation("CrmCustomer")
  authoredCrmNotes             CustomerCrmNote[]            @relation("CrmAuthor")
  supportTickets               SupportTicket[]              @relation("TicketCustomer")
  assignedSupportTickets       SupportTicket[]              @relation("TicketAssignee")
  sellerApplications           SellerApplication[]          @relation("SellerApplicant")
  reviewedSellerApplications   SellerApplication[]          @relation("SellerApplicationReviewer")
  deliveryApplications         DeliveryPartnerApplication[] @relation("DeliveryApplicant")
  reviewedDeliveryApplications DeliveryPartnerApplication[] @relation("DeliveryApplicationReviewer")
  reviewedSellerDocuments      SellerDocument[]             @relation("SellerDocumentReviewer")
  auditLogs                    AuditLog[]                   @relation("AuditActor")
  couponRedemptions            CouponRedemption[]
  referralCodes                ReferralCode[]               @relation("ReferralOwner")
  referralRedemptions          ReferralRedemption[]         @relation("ReferralCustomer")
  supportMessages              SupportMessage[]
  StoreSetting                 StoreSetting[]

  @@index([status, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model CustomerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String?
  dateOfBirth DateTime?
  preferences Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  businessName   String
  legalName      String?
  slug           String              @unique
  description    String?
  taxId          String?
  status         SellerStatus        @default(PENDING_REVIEW)
  commissionBps  Int                 @default(1200)
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents      SellerDocument[]
  bankAccounts   SellerBankAccount[]
  products       Product[]
  sellerOrders   SellerOrder[]
  commissions    Commission[]
  settlements    SellerSettlement[]
  supportTickets SupportTicket[]
  crmNotes       CustomerCrmNote[]
  coupons        Coupon[]

  @@index([status, createdAt])
  @@index([businessName])
}

model SellerApplication {
  id              String            @id @default(cuid())
  applicantUserId String
  businessName    String
  legalName       String?
  taxId           String?
  category        String
  contactPhone    String
  status          ApplicationStatus @default(PENDING_REVIEW)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  applicant       User              @relation("SellerApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedBy      User?             @relation("SellerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([applicantUserId])
}

model SellerDocument {
  id           String        @id @default(cuid())
  sellerId     String
  documentType String
  storageKey   String
  status       String        @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy   User?         @relation("SellerDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
}

model SellerBankAccount {
  id                 String        @id @default(cuid())
  sellerId           String
  accountHolderName  String
  accountLast4       String
  providerToken      String?
  verificationStatus String        @default("PENDING")
  isDefault          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, verificationStatus])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  coupons   Coupon[]

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
}

model Product {
  id                String             @id @default(cuid())
  sellerId          String
  categoryId        String
  name              String
  slug              String             @unique
  description       String?
  status            ProductStatus      @default(DRAFT)
  basePrice         Decimal            @db.Decimal(12, 2)
  currency          String             @default("INR") @db.Char(3)
  approvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  seller            SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  images            ProductImage[]
  wishlists         WishlistItem[]
  reviews           Review[]
  couponRedemptions CouponRedemption[]
  FlashSaleItem     FlashSaleItem[]

  @@index([sellerId, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([status, createdAt])
  @@index([name])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  sku         String      @unique
  name        String
  attributes  Json?
  price       Decimal?    @db.Decimal(12, 2)
  weightGrams Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId, isActive])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  storageKey String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  quantityAvailable Int            @default(0)
  quantityReserved  Int            @default(0)
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([quantityAvailable])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String
  country       String   @default("IN") @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation("AddressOwner", fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId, isDefault])
  @@index([postalCode])
}

model Order {
  id                      String              @id @default(cuid())
  orderNumber             String              @unique
  customerId              String
  shippingAddressId       String?
  status                  OrderStatus         @default(PENDING_PAYMENT)
  currency                String              @default("INR") @db.Char(3)
  subtotal                Decimal             @db.Decimal(12, 2)
  discountTotal           Decimal             @default(0) @db.Decimal(12, 2)
  shippingTotal           Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal                Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal              Decimal             @db.Decimal(12, 2)
  shippingAddressSnapshot Json
  placedAt                DateTime            @default(now())
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  customer                User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress         Address?            @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  sellerOrders            SellerOrder[]
  payments                Payment[]
  couponRedemptions       CouponRedemption[]
  referralRedemption      ReferralRedemption?

  @@index([customerId, placedAt])
  @@index([status, placedAt])
}

model SellerOrder {
  id              String                @id @default(cuid())
  orderId         String
  sellerId        String
  status          SellerOrderStatus     @default(CONFIRMED)
  subtotal        Decimal               @db.Decimal(12, 2)
  commissionTotal Decimal               @default(0) @db.Decimal(12, 2)
  sellerPayable   Decimal               @db.Decimal(12, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller          SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  shipment        Shipment?
  commission      Commission?
  settlementItem  SellerSettlementItem?
  supportTickets  SupportTicket[]
  flashSaleItems  FlashSaleItem[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([orderId])
}

model OrderItem {
  id              String          @id @default(cuid())
  sellerOrderId   String
  variantId       String?
  productName     String
  variantName     String?
  skuSnapshot     String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal         @db.Decimal(12, 2)
  productSnapshot Json
  createdAt       DateTime        @default(now())
  sellerOrder     SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnRequests  ReturnRequest[]

  @@index([sellerOrderId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  status            PaymentStatus @default(CREATED)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  idempotencyKey    String?       @unique
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@index([orderId, status])
  @@index([provider, createdAt])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?      @unique
  idempotencyKey   String?      @unique
  requestedAt      DateTime     @default(now())
  processedAt      DateTime?
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([paymentId])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderItemId String
  status      ReturnStatus @default(REQUESTED)
  reason      String
  resolution  String?
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime     @updatedAt
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([orderItemId])
}

model Commission {
  id            String        @id @default(cuid())
  sellerOrderId String        @unique
  sellerId      String
  rateBps       Int
  amount        Decimal       @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  sellerOrder   SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
}

model SellerSettlement {
  id                String                 @id @default(cuid())
  sellerId          String
  reference         String                 @unique
  status            SettlementStatus       @default(PENDING)
  currency          String                 @default("INR") @db.Char(3)
  grossAmount       Decimal                @db.Decimal(12, 2)
  commissionAmount  Decimal                @db.Decimal(12, 2)
  adjustmentAmount  Decimal                @default(0) @db.Decimal(12, 2)
  netAmount         Decimal                @db.Decimal(12, 2)
  providerReference String?
  scheduledAt       DateTime?
  paidAt            DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  seller            SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items             SellerSettlementItem[]

  @@index([sellerId, status, createdAt])
}

model SellerSettlementItem {
  id               String           @id @default(cuid())
  settlementId     String
  sellerOrderId    String           @unique
  grossAmount      Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  netAmount        Decimal          @db.Decimal(12, 2)
  createdAt        DateTime         @default(now())
  settlement       SellerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  sellerOrder      SellerOrder      @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  @@index([settlementId])
}

model DeliveryPartner {
  id                String                      @id @default(cuid())
  userId            String                      @unique
  applicationId     String?                     @unique
  vehicleType       String?
  serviceZones      String[]
  status            UserStatus                  @default(PENDING)
  provider          String?
  providerPartnerId String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  user              User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  application       DeliveryPartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  shipments         Shipment[]

  @@index([status, createdAt])
}

model DeliveryPartnerApplication {
  id              String            @id @default(cuid())
  applicantUserId String            @unique
  vehicleType     String?
  serviceZones    String[]
  status          ApplicationStatus @default(PENDING_REVIEW)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  applicant       User              @relation("DeliveryApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedBy      User?             @relation("DeliveryApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  deliveryPartner DeliveryPartner?

  @@index([status, createdAt])
}

model Shipment {
  id                 String           @id @default(cuid())
  sellerOrderId      String           @unique
  deliveryPartnerId  String?
  status             ShipmentStatus   @default(PENDING)
  provider           String?
  providerShipmentId String?          @unique
  trackingNumber     String?          @unique
  trackingUrl        String?
  labelStorageKey    String?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  proofOfDeliveryKey String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sellerOrder        SellerOrder      @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  deliveryPartner    DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  events             ShipmentEvent[]

  @@index([deliveryPartnerId, status, createdAt])
  @@index([status, createdAt])
}

model Coupon {
  id              String             @id @default(cuid())
  sellerId        String?
  code            String             @unique
  type            CouponType
  value           Decimal            @db.Decimal(12, 2)
  currency        String             @default("INR") @db.Char(3)
  minimumSpend    Decimal?           @db.Decimal(12, 2)
  maximumDiscount Decimal?           @db.Decimal(12, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  usageLimit      Int?
  perUserLimit    Int?
  categoryId      String?
  isActive        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  seller          SellerProfile?     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category        Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  redemptions     CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@index([categoryId])
  @@index([sellerId, isActive, startsAt, endsAt])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String
  userId    String
  productId String?
  discount  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([couponId, orderId])
  @@index([couponId, userId, createdAt])
  @@index([userId, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  rating      Int
  title       String?
  body        String?
  isVerified  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([productId, isPublished, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  channel     String
  templateKey String
  payload     Json
  status      String    @default("QUEUED")
  providerId  String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([channel, status, createdAt])
}

model CustomerCrmNote {
  id         String         @id @default(cuid())
  customerId String
  sellerId   String?
  authorId   String?
  body       String
  createdAt  DateTime       @default(now())
  customer   User           @relation("CrmCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  seller     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  author     User?          @relation("CrmAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([sellerId, customerId, createdAt])
}

model SupportTicket {
  id            String           @id @default(cuid())
  customerId    String?
  sellerId      String?
  sellerOrderId String?
  assignedToId  String?
  subject       String
  description   String
  status        TicketStatus     @default(OPEN)
  priority      String           @default("NORMAL")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?
  customer      User?            @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  seller        SellerProfile?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerOrder   SellerOrder?     @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  assignedTo    User?            @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([customerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([sellerOrderId])
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  authorId      String?
  body          String
  attachmentKey String?
  isInternal    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  requestId  String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model PaymentWebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  status      String    @default("RECEIVED")
  error       String?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
}

model ShipmentEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  status          ShipmentStatus
  description     String?
  location        String?
  providerEventId String?        @unique
  occurredAt      DateTime
  createdAt       DateTime       @default(now())
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model PromoBanner {
  id          String    @id @default(cuid())
  title       String
  imageKey    String
  targetUrl   String?
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, startsAt, endsAt, sortOrder])
}

model FlashSale {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  startsAt    DateTime
  endsAt      DateTime
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       FlashSaleItem[]

  @@index([isPublished, startsAt, endsAt])
}

model FlashSaleItem {
  id            String       @id @default(cuid())
  flashSaleId   String
  productId     String
  salePrice     Decimal      @db.Decimal(12, 2)
  quantityLimit Int?
  createdAt     DateTime     @default(now())
  flashSale     FlashSale    @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  SellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id])
  sellerOrderId String?

  @@unique([flashSaleId, productId])
  @@index([productId])
}

model ReferralCode {
  id          String               @id @default(cuid())
  ownerId     String
  code        String               @unique
  isActive    Boolean              @default(true)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  owner       User                 @relation("ReferralOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]

  @@index([ownerId, isActive])
}

model ReferralRedemption {
  id             String       @id @default(cuid())
  referralCodeId String
  referredUserId String       @unique
  orderId        String?      @unique
  rewardAmount   Decimal      @default(0) @db.Decimal(12, 2)
  status         String       @default("PENDING")
  redeemedAt     DateTime     @default(now())
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referredUser   User         @relation("ReferralCustomer", fields: [referredUserId], references: [id], onDelete: Restrict)
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([referralCodeId, redeemedAt])
}

model StoreSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model SeoMetadata {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  title        String?
  description  String?
  canonicalUrl String?
  imageKey     String?
  updatedAt    DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, updatedAt])
}
