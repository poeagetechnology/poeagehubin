{
  "name": "poeage-ecom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "start": "npm run dev --workspace @poeage/web",
    "dev": "npm run dev --workspace @poeage/web",
    "dev:web": "npm run dev --workspace @poeage/web",
    "dev:api": "npm run dev --workspace @poeage/api",
    "build": "npm run build --workspace @poeage/web",
    "test": "npm test --workspace @poeage/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  }
}
